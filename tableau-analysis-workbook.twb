      <column caption='Rounded Avg. Total Spent' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_1567815646624034818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([Accommodation cost]+[Transportation cost]), 0)' />
      </column>
      <column caption='Rounded Avg. Age' datatype='real' name='[Calculation_705376352131833856]' role='measure' type='quantitative'>
